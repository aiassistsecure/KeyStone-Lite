{
  "name": "keystone-lite",
  "version": "1.1.1",
  "description": "AI-powered code debugging and editing - powered by any model",
  "main": "dist/main/index.js",
  "author": "AiAssist <dev@interchained.org>",
  "license": "BUSL",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.45.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-store": "^8.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.312.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^2.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.2.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "nedb-engine": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.10",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "@xmldom/xmldom": "^0.8.13",
    "fast-uri": "^3.1.2",
    "form-data": "^4.0.6",
    "lodash": "^4.18.0",
    "minimatch@^3.0.0": "^3.1.3",
    "minimatch@^5.0.0": "^5.1.8",
    "minimatch@^9.0.0": "^9.0.7",
    "picomatch@^2.0.0": "^2.3.2",
    "picomatch@^4.0.0": "^4.0.4",
    "rollup": "^4.59.0",
    "tar": "^7.5.16",
    "tmp": "^0.2.6",
    "ajv@^8.0.0": "^8.18.0",
    "js-yaml@^4.0.0": "^4.2.0",
    "esbuild": "^0.25.0",
    "@babel/core": "^7.29.6",
    "@tootallnate/once": "^2.0.1"
  },
  "build": {
    "appId": "com.aiassist.keystone-lite",
    "productName": "Keystone Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
